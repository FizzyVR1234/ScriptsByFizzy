-- ══════════════════════════════════════════════════════════════════════════════
--  BUILD ALL ROWS  (no-lag rewrite)
--  • Normal anims  → listFrame
--  • Custom anims  → customPanel (after the add-header + form)
--  • addSingleRow: adds ONE row directly, used by confirm-add for zero rebuild
--  • removeCustomAnim: destroys just that one row, no full rebuild
-- ══════════════════════════════════════════════════════════════════════════════
local allRows    = {}   -- {frame, anim, accent, nLbl}
local customRows = {}   -- same, for custom-tagged anims

-- forward declarations so lambdas can reference them
local buildAllRows, refreshList

-- ── helper: create one row frame and wire it up ───────────────────────────────
--
--  Row pixel layout (row width = CARD_W - 20 = 290px):
--  Normal:  [2 accent][4 gap][★ 20px][4 gap][name label ... ][4 gap][keybind 30px][4 gap right]
--  Custom:  [2 accent][4 gap][★ 20px][4 gap][name label ... ][4 gap][keybind 30px][8 gap][✕ 14px][2 gap right]
--
--  Right-side totals:
--    Normal: 30kb + 4 + 4 = 38px from right  → keybind starts at -38
--    Custom: 14del + 2 + 30kb + 4 + 4 = 54px from right → keybind starts at -54, del at -16
--
local function makeAnimRow(anim, i)
    local isCustom = anim.tag=="custom"
    local parent   = isCustom and customPanel or listFrame

    -- pixel constants for right-side buttons
    local DEL_W    = 14   -- ✕ width
    local DEL_GAP  = 4    -- gap between keybind and ✕
    local KB_W     = 30   -- keybind width
    local KB_GAP   = 4    -- gap between name and keybind (and between keybind and right edge)
    local STAR_W   = 20   -- star width
    local STAR_X   = 6    -- star left offset from row edge (after accent)
    local NAME_X   = STAR_X + STAR_W + 4  -- name label left start

    -- keybind right edge: leave room for ✕ + gap if custom, else just a small right pad
    local KB_RIGHT = isCustom and -(DEL_W + DEL_GAP + KB_GAP) or -(KB_GAP)
    -- keybind left offset from right edge
    local KB_FROM_RIGHT = KB_W + math.abs(KB_RIGHT)
    -- delete button right edge (custom only)
    local DEL_RIGHT = -2

    local row=Instance.new("Frame"); row.Size=UDim2.new(1,0,0,ROW_H)
    row.BackgroundColor3=TH.listItem; row.BackgroundTransparency=0.2
    row.BorderSizePixel=0; row.ZIndex=14; row.LayoutOrder=isCustom and (100+i) or i
    row.Visible=true; row.Parent=parent

    local accent=Instance.new("Frame"); accent.Size=UDim2.new(0,2,0,ROW_H-8)
    accent.Position=UDim2.new(0,0,0.5,-(ROW_H-8)/2); accent.BackgroundColor3=TH.toggleOn
    accent.BackgroundTransparency=0.6; accent.BorderSizePixel=0; accent.ZIndex=15; accent.Parent=row
    Instance.new("UICorner",accent).CornerRadius=UDim.new(1,0)

    -- ★ star on the LEFT side, after the accent bar
    local star=Instance.new("TextButton"); star.Size=UDim2.new(0,STAR_W,0,STAR_W)
    star.Position=UDim2.new(0,STAR_X,0.5,-STAR_W/2)
    star.BackgroundTransparency=1
    star.Text = anim.fav and "★" or "☆"
    star.TextColor3=anim.fav and TH.starOn or TH.starOff; star.TextSize=15
    star.Font=Enum.Font.GothamBold; star.BorderSizePixel=0; star.ZIndex=17
    star.AutoButtonColor=false; star.Parent=row
    star.MouseButton1Click:Connect(function()
        anim.fav=not anim.fav
        star.Text = anim.fav and "★" or "☆"
        TweenService:Create(star,TweenInfo.new(0.12),{TextColor3=anim.fav and TH.starOn or TH.starOff}):Play()
        if currentTab=="Favs" then refreshList() end
        task.defer(saveFavorites)
    end)

    -- name label: starts after star, ends before keybind
    local lblRightPad = isCustom and -(KB_FROM_RIGHT + DEL_W + DEL_GAP + 2) or -(KB_FROM_RIGHT + 2)
    local nLbl=Instance.new("TextLabel")
    nLbl.Size=UDim2.new(1,lblRightPad,1,0); nLbl.Position=UDim2.new(0,NAME_X,0,0)
    nLbl.BackgroundTransparency=1; nLbl.Text=anim.n; nLbl.TextColor3=TH.titleColor; nLbl.TextSize=9
    nLbl.Font=Enum.Font.GothamBold; nLbl.TextXAlignment=Enum.TextXAlignment.Left
    nLbl.TextTruncate=Enum.TextTruncate.AtEnd; nLbl.ZIndex=15; nLbl.Parent=row

    -- keybind button on the right — compute absolute pixel X from left of row
    -- ROW_W = CARD_W - 20 (the listOuter is inset 10px each side)
    local ROW_W = CARD_W - 20
    -- right side space: for custom we need room for ✕(14) + gap(4) + kb_gap(4) = 22; normal just kb_gap(4)
    local kbRightSpace = isCustom and (DEL_W + DEL_GAP + KB_GAP) or KB_GAP
    -- absolute left pixel of keybind button inside the row
    local kbAbsX = ROW_W - kbRightSpace - KB_W
    local kbAbsY = math.floor((ROW_H - (ROW_H-10)) / 2)
    local getKey,setKey=makeKeybindBtn(row, kbAbsX, kbAbsY, KB_W, ROW_H-10, 16)
    anim._getKey=getKey; anim._setKey=setKey; anim._row=row

    -- ✕ delete button (custom only) — flush far right
    if isCustom then
        local delBtn=Instance.new("TextButton"); delBtn.Size=UDim2.new(0,DEL_W,0,ROW_H)
        delBtn.Position=UDim2.new(1,-DEL_W-2,0,0)
        delBtn.BackgroundTransparency=1
        delBtn.Text="x"; delBtn.TextColor3=Color3.fromRGB(200,80,80); delBtn.TextSize=12
        delBtn.Font=Enum.Font.GothamBold; delBtn.BorderSizePixel=0; delBtn.ZIndex=17
        delBtn.AutoButtonColor=false; delBtn.Parent=row
        delBtn.MouseEnter:Connect(function()
            TweenService:Create(delBtn,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(255,100,100)}):Play()
        end)
        delBtn.MouseLeave:Connect(function()
            TweenService:Create(delBtn,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(180,80,80)}):Play()
        end)
        delBtn.MouseButton1Click:Connect(function()
            if dawlatul.animation.state.current_url==anim.url then API.stop_animation() end
            dawlatul.animation.cache[anim.url]=nil
            for idx=#animDB,1,-1 do if animDB[idx]==anim then table.remove(animDB,idx) end end
            for idx=#customRows,1,-1 do
                if customRows[idx].anim==anim then table.remove(customRows,idx) end
            end
            row:Destroy()
            emptyCustomLbl.Visible=(#customRows==0) and not formOpen
            task.defer(saveCustom)
        end)
    end

    -- invisible play hit-area — only covers name label area (left side), never over buttons
    local playRightEdge = isCustom and -(KB_FROM_RIGHT + DEL_W + DEL_GAP + 2) or -(KB_FROM_RIGHT + 2)
    local play=Instance.new("TextButton"); play.Size=UDim2.new(1,playRightEdge,1,0)
    play.Position=UDim2.new(0,NAME_X,0,0); play.BackgroundTransparency=1; play.Text=""
    play.BorderSizePixel=0; play.ZIndex=14; play.Parent=row

    play.MouseEnter:Connect(function()
        if curAnimUrl~=anim.url then
            TweenService:Create(row,TweenInfo.new(0.1),{BackgroundColor3=TH.listHov,BackgroundTransparency=0}):Play()
            TweenService:Create(accent,TweenInfo.new(0.1),{BackgroundTransparency=0.2}):Play()
            TweenService:Create(nLbl,TweenInfo.new(0.1),{TextColor3=Color3.fromRGB(230,230,255)}):Play()
        end
    end)
    play.MouseLeave:Connect(function()
        local playing=curAnimUrl==anim.url
        TweenService:Create(row,TweenInfo.new(0.12),{BackgroundColor3=playing and TH.playingRow or TH.listItem,BackgroundTransparency=playing and 0 or 0.2}):Play()
        TweenService:Create(accent,TweenInfo.new(0.12),{BackgroundTransparency=playing and 0 or 0.6}):Play()
        TweenService:Create(nLbl,TweenInfo.new(0.12),{TextColor3=playing and Color3.fromRGB(220,220,255) or TH.titleColor}):Play()
    end)
    play.MouseButton1Down:Connect(function()
        TweenService:Create(row,TweenInfo.new(0.06),{BackgroundColor3=TH.toggleOn,BackgroundTransparency=0}):Play()
        TweenService:Create(accent,TweenInfo.new(0.06),{BackgroundTransparency=0}):Play()
    end)
    play.MouseButton1Up:Connect(function()
        local playing=curAnimUrl==anim.url
        TweenService:Create(row,TweenInfo.new(0.15),{BackgroundColor3=playing and TH.playingRow or TH.listHov,BackgroundTransparency=0}):Play()
    end)
    play.MouseButton1Click:Connect(function()
        if anim.url~="" then task.spawn(function() API.play_animation(anim.url) end) end
    end)

    local entry={frame=row,anim=anim,accent=accent,nLbl=nLbl}
    if isCustom then
        customRows[#customRows+1]=entry
    else
        allRows[#allRows+1]=entry
    end
    return entry
end

-- full rebuild (called once on load, and when needed)
buildAllRows = function()
    for _,e in ipairs(allRows)    do if e.frame and e.frame.Parent then e.frame:Destroy() end end
    for _,e in ipairs(customRows) do if e.frame and e.frame.Parent then e.frame:Destroy() end end
    allRows={}; customRows={}

    for i,anim in ipairs(animDB) do
        makeAnimRow(anim, i)
    end
end

-- ══════════════════════════════════════════════════════════════════════════════
--  CONFIRM ADD — no rebuild, just insert one row
-- ══════════════════════════════════════════════════════════════════════════════
confirmBtn.MouseButton1Click:Connect(function()
    local nm=nameIn.Text:match("^%s*(.-)%s*$"); local code=codeIn.Text:match("^%s*(.-)%s*$")
    if nm=="" then return end
    if code=="" then return end
    local fn,parseErr=loadstring(code)
    if not fn then return end
    local ok,res=pcall(fn)
    if not ok then return end
    if type(res)~="table" then return end
    local fk=next(res); if not fk then return end
    local kfs=res[fk]
    if type(kfs)~="table" or #kfs==0 then return end

    customCtr=customCtr+1; local fu="__custom__"..customCtr
    dawlatul.animation.cache[fu]=kfs
    local newAnim={n=nm,url=fu,fav=false,tag="custom"}
    animDB[#animDB+1]=newAnim
    makeAnimRow(newAnim, #animDB)
    emptyCustomLbl.Visible=false -- form is open, never show while adding

    task.delay(0.8,function() setFormOpen(false) end)
    refreshList()
    task.defer(saveCustom)
end)

