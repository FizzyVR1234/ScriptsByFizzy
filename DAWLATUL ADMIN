    BodyLayout.SortOrder     = Enum.SortOrder.LayoutOrder
    BodyLayout.Padding       = UDim.new(0, 2)

    local _pad0 = Instance.new("Frame", Body)
    _pad0.Size                = UDim2.new(1, 0, 0, 4)
    _pad0.BackgroundTransparency = 1
    _pad0.LayoutOrder         = 0

    -- Category state
    local expandedCats  = {}
    local catTotalH     = {}
    local catRowsFrames = {}
    local catTweenRows  = {}
    local _bodyTween    = nil

    local function calcBodyH()
        local h = 8
        for i in pairs(catRowsFrames) do
            h = h + CAT_H + 2
            if expandedCats[i] then h = h + (catTotalH[i] or 0) end
        end
        return math.min(h, BODY_MAX)
    end

    local function animateBodyH(closing)
        if _bodyTween then pcall(function() _bodyTween:Cancel() end) end
        local tw = closing and TW_BODY_CLOSE or TW_BODY
        _bodyTween = TweenService:Create(BodyPan, tw, {
            Size = UDim2.new(0, WIN_W, 0, calcBodyH()),
        })
        _bodyTween:Play()
    end

    -- Build one row per category
    for catIndex, category in ipairs(CommandCategories) do
        expandedCats[catIndex] = false

        local CatBtn = Instance.new("TextButton", Body)
        CatBtn.Name             = "Cat_" .. category.name
        CatBtn.Size             = UDim2.new(1, 0, 0, CAT_H)
        CatBtn.BackgroundColor3 = C_HEADER
        CatBtn.BackgroundTransparency = 0
        CatBtn.BorderSizePixel  = 0
        CatBtn.Text             = ""
        CatBtn.AutoButtonColor  = false
        CatBtn.LayoutOrder      = catIndex * 100
        CatBtn.ZIndex           = 11
        Instance.new("UICorner", CatBtn).CornerRadius = UDim.new(0, 8)

        local Arrow = Instance.new("TextLabel", CatBtn)
        Arrow.Size               = UDim2.new(0, CAT_H, 1, 0)
        Arrow.Position           = UDim2.new(0, 3, 0, 0)
        Arrow.BackgroundTransparency = 1
        Arrow.Font               = Enum.Font.GothamBold
        Arrow.TextSize           = 10
        Arrow.TextColor3         = C_ACCENT
        Arrow.Text               = "▶"
        Arrow.ZIndex             = 12

        local CatLbl = Instance.new("TextLabel", CatBtn)
        CatLbl.Size              = UDim2.new(1, -(CAT_H + 4), 1, 0)
        CatLbl.Position          = UDim2.new(0, CAT_H + 2, 0, 0)
        CatLbl.BackgroundTransparency = 1
        CatLbl.Font              = Enum.Font.GothamBold
        CatLbl.TextSize          = FR
        CatLbl.TextColor3        = C_TEXT
        CatLbl.TextXAlignment    = Enum.TextXAlignment.Left
        CatLbl.Text              = category.name
        CatLbl.ZIndex            = 12

