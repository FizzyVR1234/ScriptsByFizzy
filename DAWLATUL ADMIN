-- ── getBillboardScreenRect: maps a BillboardGui to a screen-space rect ───────
local function getBillboardScreenRect(bb, head, lerpTRef)
    if not bb   or not bb.Parent   then return nil end
    if not head or not head.Parent then return nil end

    local lt       = lerpTRef and lerpTRef[1] or 1
    local baseWidth = bb.Size.X.Offset
    local curW     = math.floor(lerp(MINI_W, baseWidth, lt))
    local curH     = math.floor(lerp(MINI_H, FULL_H, lt))
    local bbH      = bb.Size.Y.Offset
    local crownPx  = math.max(0, bbH - curH)

    local sp, onScreen = Cam:WorldToViewportPoint(head.Position)
    if not onScreen or sp.Z <= 0 then return nil end

    local vp        = Cam.ViewportSize
    local pxPerStud = (vp.Y * 0.5)
        / (sp.Z * math.tan(math.rad(Cam.FieldOfView) * 0.5))
    local offsetPx  = bb.StudsOffset.Y * pxPerStud
    local totalPx   = curH + crownPx
    local bbTopY    = (sp.Y - offsetPx) - totalPx * 0.5
    local tagTopY   = bbTopY + crownPx
    local tagLeftX  = sp.X - curW * 0.5

    return { x = tagLeftX, y = tagTopY, w = curW, h = curH }
end

-- Overlay heartbeat: updates / purges click-overlay entries every frame
addC(RunService.Heartbeat:Connect(function()
    local i = 1
    while i <= #overlayEntries do
        local entry = overlayEntries[i]
        local frame = entry.frame

        -- Purge dead entries immediately
        if not frame or not frame.Parent
        or not entry.hrp or not entry.hrp.Parent then
            if frame and frame.Parent then frame:Destroy() end
            table.remove(overlayEntries, i)
            -- don't advance i — the next entry is now at position i
        else
            if not entry.head or not entry.head.Parent then
                frame.Visible = false
                i = i + 1
                continue
            end
            local myHRP = LP.Character
                and LP.Character:FindFirstChild("HumanoidRootPart")
            local d = myHRP
                and (entry.hrp.Position - myHRP.Position).Magnitude
                or  0
            if d > HIDE_DIST or not entry.visible then
                frame.Visible = false
                i = i + 1
                continue
            end
            local rect = getBillboardScreenRect(entry.bb, entry.head, entry.lerpTRef)
            if not rect then
                frame.Visible = false
                i = i + 1
                continue
            end
            frame.Size     = UDim2.new(0, rect.w, 0, rect.h)
            frame.Position = UDim2.new(0, rect.x, 0, rect.y)
            frame.Visible  = true
            i = i + 1
        end
    end
end))


