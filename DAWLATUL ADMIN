-- Build-generation counter: incremented on every new build attempt.
-- Stale heartbeats/coroutines check this to abort early.
local buildGen = {}

-- Per-player auxiliary connections (stored separately so they can be
-- disconnected cleanly on every SetupPlayerTag call without leaking).
local playerConns = {}

local function disconnectPlayerConns(uid)
    local list = playerConns[uid]
    if list then
        for _, c in ipairs(list) do
            pcall(function() c:Disconnect() end)
        end
    end
    playerConns[uid] = {}
end

local function trackPlayerConn(uid, conn)
    if not playerConns[uid] then playerConns[uid] = {} end
    table.insert(playerConns[uid], conn)
end

-- ── Command cooldown helpers ──────────────────────────────────────────────────
local _cmdCooldowns = {}

local function IsCmdOnCooldown(cmd)
    local u = _cmdCooldowns[cmd]
    return u ~= nil and tick() < u
end

local function CmdCooldown(cmd, duration)
    if IsCmdOnCooldown(cmd) then return true end
    _cmdCooldowns[cmd] = tick() + duration
    return false
end

-- ── Destroy all active tags and rebuild from scratch ─────────────────────────
local function ReloadAllTags()
    for _, player in ipairs(Players:GetPlayers()) do
        local uid = player.UserId
        buildGen[uid] = (buildGen[uid] or 0) + 1
        disconnectPlayerConns(uid)

        local ac = activeConns[uid]
        if ac and ac.Connected then ac:Disconnect() end
        activeConns[uid] = nil

        local hrp = playerHRPs[uid]
        if hrp and hrp.Parent then
            local head = player.Character
                and player.Character:FindFirstChild("Head")
            if head then
                local tag = head:FindFirstChild("DawlatulTag")
                if tag then tag:Destroy() end
            end
            local tag2 = hrp:FindFirstChild("DawlatulTag")
            if tag2 then tag2:Destroy() end
        end

        playerHRPs[uid]  = nil
        playerHeads[uid] = nil

        for i, e in ipairs(overlayEntries) do
            if e.hrp == hrp then
                if e.frame and e.frame.Parent then e.frame:Destroy() end
                table.remove(overlayEntries, i)
                break
            end
        end
    end

    activeTagCount = 0
    task.wait(0.1)

    for _, player in ipairs(Players:GetPlayers()) do
        if tagsVisible then
            task.spawn(function() pcall(SetupPlayerTag, player) end)
        end
    end
end

