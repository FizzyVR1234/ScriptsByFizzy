        -- Bottom padding for this category's row list
        local BPadX = Instance.new("Frame", RowsFrame)
        BPadX.Size                = UDim2.new(1, 0, 0, 4)
        BPadX.BackgroundTransparency = 1
        BPadX.LayoutOrder         = 999
        totalRowsH = totalRowsH + 4

        catTotalH[catIndex]     = totalRowsH
        catRowsFrames[catIndex] = RowsFrame

        -- Toggle expand/collapse for this category
        local function toggleCat()
            if catTweenRows[catIndex] then
                pcall(function() catTweenRows[catIndex]:Cancel() end)
                catTweenRows[catIndex] = nil
            end
            expandedCats[catIndex] = not expandedCats[catIndex]
            local exp = expandedCats[catIndex]
            Arrow.Text = exp and "▼" or "▶"
            TweenService:Create(CatBtn, TW_CAT, {
                BackgroundColor3 = exp and C_ROW_H or C_HEADER,
            }):Play()

            if exp then
                RowsFrame.Size    = UDim2.new(1, 0, 0, 0)
                RowsFrame.Visible = true
                local tw = TweenService:Create(
                    RowsFrame,
                    TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                    { Size = UDim2.new(1, 0, 0, totalRowsH) }
                )
                catTweenRows[catIndex] = tw
                tw:Play()
                tw.Completed:Once(function()
                    if expandedCats[catIndex] and RowsFrame and RowsFrame.Parent then
                        RowsFrame.Size = UDim2.new(1, 0, 0, totalRowsH)
                    end
                    catTweenRows[catIndex] = nil
                end)
            else
                local tw = TweenService:Create(
                    RowsFrame,
                    TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
                    { Size = UDim2.new(1, 0, 0, 0) }
                )
                catTweenRows[catIndex] = tw
                tw:Play()
                tw.Completed:Once(function()
                    if not expandedCats[catIndex] and RowsFrame and RowsFrame.Parent then
                        RowsFrame.Visible = false
                        RowsFrame.Size    = UDim2.new(1, 0, 0, 0)
                    end
                    catTweenRows[catIndex] = nil
                end)
            end

            animateBodyH(not exp)
        end

        addC(IsMobile
            and CatBtn.Activated:Connect(toggleCat)
            or  CatBtn.MouseButton1Click:Connect(toggleCat)
        )
        if not IsMobile then
            addC(CatBtn.MouseEnter:Connect(function()
                if not expandedCats[catIndex] then
                    TweenService:Create(CatBtn, TW_CAT, { BackgroundColor3 = C_ROW_H }):Play()
                end
            end))
            addC(CatBtn.MouseLeave:Connect(function()
                if not expandedCats[catIndex] then
                    TweenService:Create(CatBtn, TW_CAT, { BackgroundColor3 = C_HEADER }):Play()
                end
            end))
        end
    end

    -- Bottom padding
    local BPadBot = Instance.new("Frame", Body)
    BPadBot.Size                = UDim2.new(1, 0, 0, 4)
    BPadBot.BackgroundTransparency = 1
    BPadBot.LayoutOrder         = 99999

    -- Collapse / expand panel
    local panelOpen = true
    local function SetOpen(open)
        panelOpen         = open
        CollapseBtn.Text  = open and "▲" or "▼"
        if open then
            BodyPan.Visible = true
            task.defer(function()
                if _bodyTween then pcall(function() _bodyTween:Cancel() end) end
                _bodyTween = TweenService:Create(BodyPan, TW_BODY, {
                    Size = UDim2.new(0, WIN_W, 0, calcBodyH()),
                })
                _bodyTween:Play()
            end)
        else
            if _bodyTween then pcall(function() _bodyTween:Cancel() end) end
            _bodyTween = TweenService:Create(BodyPan, TW_BODY_CLOSE, {
                Size = UDim2.new(0, WIN_W, 0, 0),
            })
            _bodyTween:Play()
            _bodyTween.Completed:Once(function()
                if not panelOpen and BodyPan and BodyPan.Parent then
                    BodyPan.Visible = false
                end
            end)
        end
    end

    addC(IsMobile
        and CollapseBtn.Activated:Connect(function() SetOpen(not panelOpen) end)
        or  CollapseBtn.MouseButton1Click:Connect(function() SetOpen(not panelOpen) end)
    )

    SetOpen(true)
end


-- ════════════════════════════════════════════════════════════════════════════
--  SECTION 7 — CLIENT REGISTRATION + PLAYER MONITORING
-- ════════════════════════════════════════════════════════════════════════════

local _active = true
shared[SHARED_KEY][LP.UserId] = true

local function UnregisterClient(player)
    if not shared[SHARED_KEY][player.UserId] then return end
    shared[SHARED_KEY][player.UserId] = nil
    task.spawn(function() pcall(SetupPlayerTag, player) end)
end

local function MonitorPlayer(player)
    if player == LP then return end
    -- SetupPlayerTag already installs all character watchers.
    -- MonitorPlayer just handles PlayerRemoving cleanup.
    addC(Players.PlayerRemoving:Connect(function(leaving)
        if leaving == player then UnregisterClient(player) end
    end))
end

-- New-client detection heartbeat
local _knownClients = {}
addC(RunService.Heartbeat:Connect(function()
    if not shared[SHARED_KEY] then return end
    for uid in pairs(shared[SHARED_KEY]) do
        if not _knownClients[uid] then
            _knownClients[uid] = true
            local player = Players:GetPlayerByUserId(uid)
            if player and player ~= LP then
                task.spawn(function() pcall(SetupPlayerTag, player) end)
            end
        end
    end
end))

-- Chat command listener
addC(LP.Chatted:Connect(function(msg)
    local lm = string.lower(msg)
    for _, cat in ipairs(CommandCategories) do
        for _, cmd in ipairs(cat.commands) do
            if lm == cmd.cmd and cmd.func then
                cmd.func()
            end
        end
    end
end))

-- Process players already in the server on boot
for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(MonitorPlayer, p)
    task.spawn(function() pcall(SetupPlayerTag, p) end)
end

-- Watch for new players joining
addC(Players.PlayerAdded:Connect(function(p)
    task.spawn(MonitorPlayer, p)
    task.spawn(function() pcall(SetupPlayerTag, p) end)
end))

addC(Players.PlayerRemoving:Connect(CleanupPlayerTag))

-- Periodically re-register self in case shared table was wiped
task.spawn(function()
    while _active do
        task.wait(REBROADCAST)
        if shared[SHARED_KEY] then
            shared[SHARED_KEY][LP.UserId] = true
        end
    end
end)

-- ── Launch ────────────────────────────────────────────────────────────────────
BuildCommandUI()
task.delay(1.5, function() startRef.done = true end)
print("[" .. HUB_NAME .. "] ✅ Loaded")
