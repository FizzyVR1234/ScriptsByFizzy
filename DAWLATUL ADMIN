-- ── Build: constructs the BillboardGui tag and drives its heartbeat ──────────
local function Build(hrp, head, player, tagType, subKey, themeData, myGeneration)
    if IsMobile and activeTagCount >= MOB_MAX then return nil end
    activeTagCount = activeTagCount + 1

    local C       = themeData
    local isOwner = (tagType == "owner")
    local T       = isOwner and C.theme or C

    -- Theme colors
    local nameCol     = T.name
    local userCol     = T.user
    local bgCol       = T.bg
    local borderCol   = T.border
    local gradA       = T.gradA or T.bg
    local gradB       = T.gradB or T.bg
    local borderColB  = T.borderB   or borderCol
    local nameGlitch  = T.nameGlitch or nameCol
    local avBorderCol = T.avBorder
    local hoverCol    = T.hover
    local sparkCols   = T.spark
    local iconId      = isOwner and C.icon or (C.icon or "rbxassetid://7414445509")
    local doGlitch    = isOwner or (C.glitch == true)

    -- Display name / username
    local showName, showUser
    if isOwner then
        if C.showDisplayName then
            showName = player and player.DisplayName or "Player"
            showUser = player and ("@" .. player.Name) or "@unknown"
        else
            showName = C.displayName or "Owner"
            showUser = C.username    or "@unknown"
        end
    else
        showName = player and player.DisplayName or "Player"
        showUser = player and ("@" .. player.Name) or "@unknown"
    end

    -- Dynamic width: fits text but never squishes short names
    local MONO      = 0.603
    local NAME_CW   = 13 * MONO  -- px/char at TextSize 13 RobotoMono
    local USER_CW   = 9  * MONO  -- px/char at TextSize 9  RobotoMono
    local OVERHEAD  = 60          -- avatar + left pad + gap
    local MIN_TAG_W = 140
    local namePx    = #showName * NAME_CW
    local userPx    = #showUser  * USER_CW
    local baseWidth = math.ceil(math.max(math.max(namePx, userPx) + OVERHEAD, MIN_TAG_W))
    local cooldownKey = tostring(hrp)

    local function getWalkDist()
        local mc = LP.Character
        local mh = mc and mc:FindFirstChild("HumanoidRootPart")
        if mh and hrp and hrp.Parent then
            return (mh.Position - hrp.Position).Magnitude
        end
        return 0
    end

    local initDist = getWalkDist()
    local lerpT = initDist < FULL_DIST and 1
        or initDist >= SHRINK_START and 0
        or 1 - (initDist - FULL_DIST) / (SHRINK_START - FULL_DIST)
    local targetT = lerpT
    local lerpTRef = { lerpT }
    local Stars    = {}

    -- Glitch & shine state
    local glitchTimer  = 0
    local glitchOn     = false
    local glitchAge    = 0
    local nextGlitch   = math.random(3, 6)
    local shineTimer   = 0
    local nextShine    = math.random(4, 8)

    -- Cached UI refs
    local _TF, _avFrame, _avStroke, _stroke
    local _nameLabel, _userLabel
    local _gb1, _gb2, _shine, _crown, _bgGrad

    -- ── BillboardGui ─────────────────────────────────────────────────────────
    local BB = Instance.new("BillboardGui")
    BB.Name         = "DawlatulTag"
    BB.Size         = UDim2.new(0, baseWidth, 0, FULL_H + (isOwner and 40 or 0))
    BB.StudsOffset  = Vector3.new(0, 2.0, 0)
    BB.AlwaysOnTop  = true
    BB.LightInfluence = 0
    BB.ResetOnSpawn = false
    BB.MaxDistance  = HIDE_DIST
    BB.Enabled      = true
    BB.Parent       = head

    -- Tag frame
    local TF = Instance.new("Frame")
    TF.Name             = "TagFrame"
    TF.Size             = UDim2.new(1, 0, 0, FULL_H)
    TF.Position         = UDim2.new(0, 0, 0, isOwner and 40 or 0)
    TF.BackgroundColor3 = bgCol
    TF.BorderSizePixel  = 0
    TF.ZIndex           = 2
    TF.ClipsDescendants = true
    TF.Parent           = BB
    _TF = TF
    Instance.new("UICorner", TF).CornerRadius = UDim.new(0, 12)

    local BG = Instance.new("UIGradient")
    BG.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   gradA),
        ColorSequenceKeypoint.new(0.5, gradB),
        ColorSequenceKeypoint.new(1,   gradA),
    })
    BG.Rotation = 120
    BG.Parent   = TF
    _bgGrad     = BG

    local St = Instance.new("UIStroke")
    St.Thickness        = 1.4
    St.ApplyStrokeMode  = Enum.ApplyStrokeMode.Border
    St.Color            = borderCol
    St.Transparency     = isOwner and 0.40 or 0.28
    St.Parent           = TF
    _stroke             = St

    local hoverStroke = Instance.new("UIStroke")
    hoverStroke.Thickness       = 3.5
    hoverStroke.Transparency    = 1
    hoverStroke.Color           = hoverCol
    hoverStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hoverStroke.Parent          = TF

    -- Click overlay (teleport on click)
    local overlayEntry
    if player ~= LP then
        overlayEntry = AddOverlayEntry(
            hrp, head, cooldownKey,
            function(key)
                if not hrp or not hrp.Parent then return end
                DoTagTeleport(hrp, key)
            end,
            hoverStroke, lerpTRef, BB
        )
    end

    -- Shine sweep (owner / glitch only)
    if (isOwner or doGlitch) and not IsMobile then
        local Sh = Instance.new("Frame")
        Sh.Name             = "Shine"
        Sh.Size             = UDim2.new(0, 50, 1.6, 0)
        Sh.Position         = UDim2.new(-0.5, 0, -0.3, 0)
        Sh.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Sh.BackgroundTransparency = 1
        Sh.BorderSizePixel  = 0
        Sh.ZIndex           = 8
        Sh.Rotation         = 18
        Sh.Parent           = TF
        _shine = Sh
        local ShG = Instance.new("UIGradient")
        ShG.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    1),
            NumberSequenceKeypoint.new(0.38, 0.42),
            NumberSequenceKeypoint.new(0.62, 0.42),
            NumberSequenceKeypoint.new(1,    1),
        })
        ShG.Rotation = 90
        ShG.Parent   = Sh
    end

    -- Avatar frame
    local AvF = Instance.new("Frame")
    AvF.Size             = UDim2.new(0, 36, 0, 36)
    AvF.Position         = UDim2.new(0, 6, 0.5, -18)
    AvF.BackgroundColor3 = gradB
    AvF.BorderSizePixel  = 0
    AvF.ZIndex           = 3
    AvF.Parent           = TF
    _avFrame = AvF
    Instance.new("UICorner", AvF).CornerRadius = UDim.new(1, 0)

    local AvSt = Instance.new("UIStroke")
    AvSt.Thickness    = 1.8
    AvSt.Transparency = 0.12
    AvSt.Color        = avBorderCol
    AvSt.Parent       = AvF
    _avStroke = AvSt

    local AvImg = Instance.new("ImageLabel")
    AvImg.Size                   = UDim2.new(1, 0, 1, 0)
    AvImg.BackgroundTransparency = 1
    AvImg.ZIndex                 = 4
    AvImg.Image = isOwner
        and iconId
        or (player
            and ("https://www.roblox.com/headshot-thumbnail/image?userId="
                .. player.UserId
                .. "&width=48&height=48&format=png")
            or  iconId)
    AvImg.Parent = AvF
    Instance.new("UICorner", AvImg).CornerRadius = UDim.new(1, 0)

    -- Crown (owner only)
    if isOwner then
        local Crown = Instance.new("ImageLabel")
        Crown.Name               = "Crown"
        Crown.Size               = UDim2.new(0, 28, 0, 28)
        Crown.Position           = UDim2.new(0, 13, 0, 6)
        Crown.BackgroundTransparency = 1
        Crown.Image              = "rbxassetid://12916400638"
        Crown.ImageColor3        = borderCol
        Crown.ZIndex             = 10
        Crown.Parent             = BB
        _crown = Crown
    end

    -- Name label
    local NL = Instance.new("TextLabel")
    NL.Size                  = UDim2.new(1, -56, 0, 18)
    NL.Position              = UDim2.new(0, 50, 0, 6)
    NL.BackgroundTransparency = 1
    NL.Font                  = Enum.Font.RobotoMono
    NL.TextSize              = 13
    NL.TextXAlignment        = Enum.TextXAlignment.Left
    NL.TextYAlignment        = Enum.TextYAlignment.Center
    NL.TextStrokeTransparency = 1
    NL.ZIndex                = 5
    NL.TextColor3            = nameCol
    NL.TextTransparency      = 1
    NL.Text                  = showName
    NL.Parent                = TF
    _nameLabel = NL

    -- Username label
    local UL = Instance.new("TextLabel")
    UL.Size                   = UDim2.new(1, -56, 0, 13)
    UL.Position               = UDim2.new(0, 50, 0, 27)
    UL.BackgroundTransparency = 1
    UL.Font                   = Enum.Font.RobotoMono
    UL.TextSize               = 9
    UL.TextXAlignment         = Enum.TextXAlignment.Left
    UL.TextYAlignment         = Enum.TextYAlignment.Center
    UL.TextStrokeTransparency = 0.65
    UL.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
    UL.ZIndex                 = 5
    UL.TextColor3             = userCol
    UL.TextTransparency       = 1
    UL.Text                   = showUser
    UL.Parent                 = TF
    _userLabel = UL

    -- Glitch bars
    if doGlitch and not IsMobile then
        _gb1 = Instance.new("Frame")
        _gb1.Size             = UDim2.new(0.44, 0, 0, 2)
        _gb1.Position         = UDim2.new(0.16, 0, 0.28, 0)
        _gb1.BackgroundColor3 = borderCol
        _gb1.BackgroundTransparency = 1
        _gb1.BorderSizePixel  = 0
        _gb1.ZIndex           = 7
        _gb1.Parent           = TF

        _gb2 = Instance.new("Frame")
        _gb2.Size             = UDim2.new(0.24, 0, 0, 1)
        _gb2.Position         = UDim2.new(0.32, 0, 0.72, 0)
        _gb2.BackgroundColor3 = borderColB
        _gb2.BackgroundTransparency = 1
        _gb2.BorderSizePixel  = 0
        _gb2.ZIndex           = 7
        _gb2.Parent           = TF
    end

    -- Sparkles
    local pCount = SPARKLE_CT
    for _ = 1, pCount do
        local s = Instance.new("ImageLabel")
        s.Image              = "rbxasset://textures/particles/sparkles_main.dds"
        s.BackgroundTransparency = 1
        s.ZIndex             = 6
        s.AnchorPoint        = Vector2.new(0.5, 0.5)
        s.ImageTransparency  = 1
        local v = math.random()
        s.ImageColor3 = v < 0.4 and sparkCols[1]
            or (v < 0.75 and sparkCols[2] or sparkCols[3])
        local sz = math.random(isOwner and 5 or 4, isOwner and 14 or 11)
        local rx = math.random(8, 94) / 100
        local ry = math.random(7, 90) / 100
        s.Size     = UDim2.new(0, sz, 0, sz)
        s.Position = UDim2.new(rx, 0, ry, 0)
        s.Parent   = TF
        table.insert(Stars, {
            L        = s,
            phase    = math.random() * math.pi * 2,
            speed    = 0.7 + math.random() * 2.2,
            bx       = rx,
            by       = ry,
            dx       = (math.random() - 0.5) * 0.0005,
            dy       = (math.random() - 0.5) * 0.0004,
            baseSize = sz,
        })
    end

    -- ── TriggerShine: plays the shine sweep animation ─────────────────────────
    local function TriggerShine()
        if not _shine or not _shine.Parent then return end
        _shine.Position = UDim2.new(-0.5, 0, -0.3, 0)
        TweenService:Create(
            _shine,
            TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
            { Position = UDim2.new(1.5, 0, -0.3, 0) }
        ):Play()
    end

    -- ── Main heartbeat ────────────────────────────────────────────────────────
    local gradRotation   = 0
    local lastUpdateTime = 0
    local hbConn

    hbConn = RunService.Heartbeat:Connect(function(dt)

        -- Abort if a newer build has superseded this one
        if myGeneration and player and buildGen[player.UserId] ~= myGeneration then
            hbConn:Disconnect()
            if overlayEntry then RemoveOverlayEntry(hrp) end
            activeTagCount = math.max(0, activeTagCount - 1)
            return
        end

        local t = tick()
        if IsMobile then
            if t - lastUpdateTime < MOB_RATE then return end
            lastUpdateTime = t
        end

        -- TF gone = head was destroyed; let the Character watcher rebuild
        if not TF or not TF.Parent then
            hbConn:Disconnect()
            if overlayEntry then RemoveOverlayEntry(hrp) end
            activeTagCount = math.max(0, activeTagCount - 1)
            return
        end

        -- Distance check
        local walkDist = getWalkDist()
        if walkDist >= HIDE_DIST then
            BB.Enabled = false
            if overlayEntry then overlayEntry.visible = false end
            return
        end
        BB.Enabled = true

        -- Lerp target
        if      walkDist < FULL_DIST      then targetT = 1
        elseif  walkDist >= SHRINK_START  then targetT = 0
        else    targetT = 1 - (walkDist - FULL_DIST) / (SHRINK_START - FULL_DIST)
        end
        lerpT           = lerp(lerpT, targetT, math.min(1, dt * ANIM_SPEED))
        lerpTRef[1]     = lerpT

        -- Size & position
        local crownSpace = isOwner and math.floor(lerp(20, 40, lerpT)) or 0
        local curW       = math.floor(lerp(MINI_W, baseWidth, lerpT))
        local curH       = math.floor(lerp(MINI_H, FULL_H, lerpT))
        BB.Size   = UDim2.new(0, curW, 0, curH + crownSpace)
        TF.Size   = UDim2.new(0, curW, 0, curH)
        TF.Position = UDim2.new(0, 0, 0, crownSpace)

        -- Corner radius
        local cr = math.floor(lerp(MINI_H / 2, 12, lerpT))
        for _, v in ipairs(TF:GetChildren()) do
            if v:IsA("UICorner") then v.CornerRadius = UDim.new(0, cr) end
        end
        TF.BackgroundTransparency = lerp(1, 0, lerpT)

        -- Gradient rotation & pulse (desktop only)
        if not IsMobile then
            gradRotation = (gradRotation + dt * 18) % 360
            if _bgGrad and _bgGrad.Parent then
                _bgGrad.Rotation = gradRotation
                local pulse = (math.sin(t * 1.2) + 1) / 2
                _bgGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,   gradA),
                    ColorSequenceKeypoint.new(0.5, lerpC(gradB, gradA, pulse * 0.5)),
                    ColorSequenceKeypoint.new(1,   gradB),
                })
            end
        end

        -- Avatar frame
        if _avFrame then
            local avSz = math.floor(lerp(MINI_H - 6, 36, lerpT))
            local avX  = math.floor(lerp((curW / 2) - (avSz / 2), 6, lerpT))
            _avFrame.Size     = UDim2.new(0, avSz, 0, avSz)
            _avFrame.Position = UDim2.new(0, avX, 0.5, -(avSz / 2))

            if _crown then
                local cSz = math.floor(avSz * 0.70)
                _crown.Size     = UDim2.new(0, cSz, 0, cSz)
                _crown.Position = UDim2.new(
                    0,
                    avX + (avSz / 2) - (cSz / 2),
                    0,
                    crownSpace - cSz - 2
                )
                if not IsMobile then
                    _crown.ImageTransparency = 0.1 + 0.15 * math.sin(t * 2.2)
                end
            end
        end

        -- Text fade
        local ta = isOwner
            and math.max(0, math.min(1, (lerpT - 0.40) / 0.45))
            or  math.max(0, math.min(1, (lerpT - 0.20) / 0.35))
        _nameLabel.TextTransparency       = 1 - ta
        _userLabel.TextTransparency       = 1 - ta
        _nameLabel.TextStrokeTransparency = 1
        _userLabel.TextStrokeTransparency = lerp(1, 0.65, ta)
        if _nameLabel.Text == "" then _nameLabel.Text = showName end
        if _userLabel.Text == "" then _userLabel.Text = showUser end

        -- Sparkles
        for _, s in ipairs(Stars) do
            if not s.L.Parent then continue end
            local tw = 0.5 + 0.5 * math.sin(t * s.speed + s.phase)
            if not IsMobile then
                s.bx = s.bx + s.dx
                s.by = s.by + s.dy
                if s.bx < 0.04 or s.bx > 0.96 then s.dx = -s.dx end
                if s.by < 0.04 or s.by > 0.92 then s.dy = -s.dy end
                s.L.Position = UDim2.new(s.bx, 0, s.by, 0)
            end
            local sa         = math.max(0, math.min(1, (lerpT - 0.05) / 0.40))
            local brightness = 0.35 + 0.57 * tw
            s.L.ImageTransparency = 1 - (brightness * sa)
            local sizeScale  = 0.55 + 0.80 * tw
            local px         = math.floor(s.baseSize * sizeScale)
            s.L.Size         = UDim2.new(0, px, 0, px)
        end

        -- Border / stroke animation (desktop)
        if not IsMobile then
            local p = (math.sin(t * 1.9) + 1) / 2
            if isOwner then
                _stroke.Transparency = lerpT > 0.3
                    and lerp(1, 0.22 + 0.30 * math.sin(t * 1.5), lerpT)
                    or  1
                if _avStroke then
                    _avStroke.Transparency = 0.05 + 0.55 * math.sin(t * 2.4)
                end
            else
                _stroke.Color        = lerpC(borderColB, borderCol, p)
                _stroke.Transparency = lerpT > 0.3
                    and lerp(1, 0.12 + 0.28 * math.sin(t * 1.9), lerpT)
                    or  1
                if _avStroke then
                    _avStroke.Color        = lerpC(borderColB, avBorderCol, p)
                    _avStroke.Transparency = 0.08 + 0.48 * math.sin(t * 2.1)
                end
            end
        end

        -- Shine timer
        if (isOwner or doGlitch) and lerpT > 0.85 and not IsMobile then
            shineTimer = shineTimer + dt
            if shineTimer >= nextShine then
                TriggerShine()
                shineTimer = 0
                nextShine  = math.random(4, 9)
            end
        end

        -- Glitch effect
        if doGlitch and lerpT > 0.5 and not IsMobile then
            glitchTimer = glitchTimer + dt
            if not glitchOn and glitchTimer >= nextGlitch then
                glitchOn    = true
                glitchAge   = 0
                glitchTimer = 0
                nextGlitch  = math.random(3, 6)
                if _gb1 then
                    _gb1.BackgroundTransparency = 0.28
                    _gb2.BackgroundTransparency = 0.38
                end
                _nameLabel.TextColor3   = nameGlitch
                _nameLabel.Position     = UDim2.new(0, 54, 0, 6)
                TF.BackgroundColor3     = lerpC(bgCol, gradA, 0.6)
            end

            if glitchOn then
                glitchAge = glitchAge + dt
                if glitchAge > 0.04 then
                    if _gb1 then
                        _gb1.BackgroundTransparency = 0.68
                        _gb2.BackgroundTransparency = 0.75
                    end
                    _nameLabel.Position = UDim2.new(0, 46, 0, 6)
                end
                if glitchAge > 0.09 then
                    if _gb1 then
                        _gb1.BackgroundTransparency = 0.36
                        _gb2.BackgroundTransparency = 0.46
                    end
                    _nameLabel.Position = UDim2.new(0, 52, 0, 6)
                end
                if glitchAge > 0.15 then
                    if _gb1 then
                        _gb1.BackgroundTransparency = 1
                        _gb2.BackgroundTransparency = 1
                    end
                    _nameLabel.TextColor3 = nameCol
                    _nameLabel.Position   = UDim2.new(0, 50, 0, 6)
                    TF.BackgroundColor3   = bgCol
                    glitchOn = false
                end
            end
        end
    end)

    addC(hbConn)
    return hbConn
end

-- ── RemoveOld: destroy DawlatulTag inside a parent ───────────────────────────
local function RemoveOld(parent)
    if not parent or not parent.Parent then return end
    local tag = parent:FindFirstChild("DawlatulTag")
    if tag then tag:Destroy() end
end

-- ── CleanupPlayerTag: bumps generation so live heartbeats abort ──────────────
local function CleanupPlayerTag(player)
    local uid = player.UserId
    buildGen[uid] = (buildGen[uid] or 0) + 1
    disconnectPlayerConns(uid)

    local ac = activeConns[uid]
    if ac and ac.Connected then ac:Disconnect() end
    activeConns[uid] = nil

    local rc = respawnConns[uid]
    if rc and rc.Connected then rc:Disconnect() end
    respawnConns[uid] = nil

    local hrp = playerHRPs[uid]
    if hrp then
        pcall(RemoveOld,         hrp)
        pcall(RemoveOverlayEntry, hrp)
        playerHRPs[uid] = nil
    end

    local hd = playerHeads[uid]
    if hd then
        pcall(RemoveOld, hd)
        playerHeads[uid] = nil
    end
end

-- ── BuildTagForChar: waits for Head+HRP, plants tag, hooks head destruction ──
local function BuildTagForChar(player, char, isFreshSpawn)
    if not player or not player.Parent then return end
    if not char then return end
    if not tagsVisible then return end

    local uid = player.UserId

    -- Stamp generation BEFORE any yields so a concurrent call cancels us
    buildGen[uid] = (buildGen[uid] or 0) + 1
    local myGen   = buildGen[uid]

    task.spawn(function()
        -- Short settle wait only for true server respawns
        if isFreshSpawn then task.wait(0.35) end
        if buildGen[uid] ~= myGen then return end
        if not player.Parent        then return end
        if not char.Parent          then return end

        -- Wait for Head and HRP
        local head = char:WaitForChild("Head",           8)
        local hrp  = char:WaitForChild("HumanoidRootPart", 8)
        if not head or not hrp       then return end
        if buildGen[uid] ~= myGen   then return end

        -- Destroy previous tag/overlay refs
        local oldHrp  = playerHRPs[uid]
        local oldHead = playerHeads[uid]
        if oldHrp  and oldHrp  ~= hrp  then
            pcall(RemoveOld,         oldHrp)
            pcall(RemoveOverlayEntry, oldHrp)
        end
        if oldHead and oldHead ~= head then
            pcall(RemoveOld, oldHead)
        end
        -- Nuke current head/hrp in case of a duplicate call on the same char
        pcall(RemoveOld,         hrp)
        pcall(RemoveOld,         head)
        pcall(RemoveOverlayEntry, hrp)

        -- Kill old heartbeat
        local ac = activeConns[uid]
        if ac and ac.Connected then ac:Disconnect() end
        activeConns[uid] = nil
        playerHRPs[uid]  = nil
        playerHeads[uid] = nil

        local tagType, subKey, themeData = GetTagType(player)
        if not (tagType and themeData) then return end

        playerHRPs[uid]   = hrp
        playerHeads[uid]  = head
        activeConns[uid]  = Build(hrp, head, player, tagType, subKey, themeData, myGen)

        -- Watch Head directly for destruction (catches ALL avatar swap methods)
        -- Goes into playerConns so it disconnects cleanly on next SetupPlayerTag call.
        local headDestroyConn
        headDestroyConn = head.AncestryChanged:Connect(function()
            if head.Parent ~= nil then return end          -- still parented, ignore
            pcall(function() headDestroyConn:Disconnect() end)
            if buildGen[uid] ~= myGen then return end      -- already superseded

            task.delay(0.05, function()
                if buildGen[uid] ~= myGen then return end
                local nc = player.Character
                if nc and nc ~= char then
                    -- Character object reference changed (normal clone/swap)
                    task.spawn(BuildTagForChar, player, nc, false)
                elseif nc and nc == char then
                    -- Same char object but Head was swapped inside it
                    task.spawn(function()
                        task.wait(0.1)
                        local newHead = nc:FindFirstChild("Head")
                        if newHead and newHead ~= head then
                            task.spawn(BuildTagForChar, player, nc, false)
                        end
                    end)
                end
            end)
        end)
        trackPlayerConn(uid, headDestroyConn)
    end)
end

-- ── SetupPlayerTag: hook ALL ways a character can change for this player ─────
SetupPlayerTag = function(player)
    if not player or not player.Parent then return end
    local uid = player.UserId
    pcall(function()
        -- Disconnect ALL previous per-player watchers before re-hooking
        disconnectPlayerConns(uid)
        if respawnConns[uid] and respawnConns[uid].Connected then
            respawnConns[uid]:Disconnect()
        end

        -- Build for the current character immediately
        if player.Character then
            task.spawn(BuildTagForChar, player, player.Character, false)
        end

        -- 1) CharacterAdded — fires on server-driven respawn
        local caConn = player.CharacterAdded:Connect(function(nc)
            task.spawn(BuildTagForChar, player, nc, true)
        end)
        addC(caConn)
        respawnConns[uid] = caConn

        -- 2) Character property change — fires when executor sets player.Character
        --    directly (reanimation, avatar clone, etc.)
        local lastChar = player.Character
        local cpConn = player:GetPropertyChangedSignal("Character"):Connect(function()
            local nc = player.Character
            if nc ~= lastChar then
                lastChar = nc
                if nc then
                    task.spawn(BuildTagForChar, player, nc, false)
                else
                    CleanupPlayerTag(player)
                end
            end
        end)
        trackPlayerConn(uid, cpConn)

        -- 3) Safety-net heartbeat — catches any executor quirk where neither
        --    CharacterAdded nor the property signal fired.
        local safetyConn
        safetyConn = RunService.Heartbeat:Connect(function()
            if not player.Parent then
                pcall(function() safetyConn:Disconnect() end)
                return
            end
            local char        = player.Character;  if not char        then return end
            local currentHead = char:FindFirstChild("Head")
            local storedHead  = playerHeads[uid]
            if storedHead and not storedHead.Parent and currentHead then
                pcall(function() safetyConn:Disconnect() end)
                task.spawn(BuildTagForChar, player, char, false)
            end
        end)
        trackPlayerConn(uid, safetyConn)
    end)
end


