    -- Divider
    local Div = Instance.new("Frame", Win)
    Div.Size             = UDim2.new(1, 0, 0, 1)
    Div.Position         = UDim2.new(0, 0, 0, TH)
    Div.BackgroundColor3 = C_DIV
    Div.BackgroundTransparency = 0.4
    Div.BorderSizePixel  = 0
    Div.ZIndex           = 11
    local DivG = Instance.new("UIGradient", Div)
    DivG.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,   0),
        NumberSequenceKeypoint.new(0.7, 0),
        NumberSequenceKeypoint.new(1,   1),
    })

    -- Titlebar heartbeat (dot pulse + shimmer)
    local globalT = 0
    addC(RunService.Heartbeat:Connect(function(dt)
        globalT = globalT + dt
        local pt     = globalT % 1.6
        local ringT  = math.clamp(pt / 1.6, 0, 1)
        local easedT = ringT < 0.5
            and 2 * ringT * ringT
            or  1 - (-2 * ringT + 2)^2 / 2
        local ringSize = math.round(6 + (14.4 - 6) * easedT)
        if TDotRing and TDotRing.Parent then
            TDotRing.Size                   = UDim2.new(0, ringSize, 0, ringSize)
            TDotRing.BackgroundTransparency = 0.5 + 0.5 * easedT
        end
        local SHIM_CYCLE = 3.2
        local st = globalT % SHIM_CYCLE
        local sf = st / (SHIM_CYCLE * 0.55)
        if TShim and TShim.Parent then
            if sf <= 1 then
                TShim.Position = UDim2.new(-0.35 + 1.35 * ease_out(sf), 0, 0, 0)
            else
                TShim.Position = UDim2.new(-0.35, 0, 0, 0)
