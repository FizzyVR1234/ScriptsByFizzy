local function lerp(a, b, t)
    return a + (b - a) * t
end

local function lerpC(a, b, t)
    return Color3.new(
        lerp(a.R, b.R, t),
        lerp(a.G, b.G, t),
        lerp(a.B, b.B, t)
    )
end

