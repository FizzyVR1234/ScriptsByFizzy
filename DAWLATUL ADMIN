        RowsFrame.Name             = "Rows_" .. category.name
        RowsFrame.Size             = UDim2.new(1, 0, 0, 0)
        RowsFrame.BackgroundTransparency = 1
        RowsFrame.BorderSizePixel  = 0
        RowsFrame.ClipsDescendants = true
        RowsFrame.LayoutOrder      = catIndex * 100 + 1
        RowsFrame.Visible          = false
        RowsFrame.ZIndex           = 10

        local RL = Instance.new("UIListLayout", RowsFrame)
        RL.FillDirection = Enum.FillDirection.Vertical
        RL.SortOrder     = Enum.SortOrder.LayoutOrder
        RL.Padding       = UDim.new(0, 3)

        local RPad = Instance.new("UIPadding", RowsFrame)
        RPad.PaddingTop   = UDim.new(0, 3)
        RPad.PaddingLeft  = UDim.new(0, 6)
        RPad.PaddingRight = UDim.new(0, 4)

        local totalRowsH = 6

        -- Command rows
        for cmdIndex, cmdData in ipairs(category.commands) do
            totalRowsH = totalRowsH + ROW_H + 3

            local Row = Instance.new("TextButton", RowsFrame)
            Row.Size             = UDim2.new(1, -6, 0, ROW_H)
            Row.BackgroundColor3 = C_ROW
            Row.BackgroundTransparency = 0.08
            Row.BorderSizePixel  = 0
            Row.Text             = ""
            Row.AutoButtonColor  = false
            Row.LayoutOrder      = cmdIndex
            Row.ZIndex           = 11
            Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 7)

            local ABar = Instance.new("Frame", Row)
            ABar.Size             = UDim2.new(0, 3, 0.55, 0)
            ABar.AnchorPoint      = Vector2.new(0, 0.5)
            ABar.Position         = UDim2.new(0, 0, 0.5, 0)
            ABar.BackgroundColor3 = C_ACCENT
            ABar.BackgroundTransparency = 1
            ABar.BorderSizePixel  = 0
            ABar.ZIndex           = 13
            Instance.new("UICorner", ABar).CornerRadius = UDim.new(1, 0)

            local RGlow = Instance.new("Frame", Row)
            RGlow.Size             = UDim2.new(0.35, 0, 1, 0)
            RGlow.AnchorPoint      = Vector2.new(1, 0)
            RGlow.Position         = UDim2.new(1, 0, 0, 0)
            RGlow.BackgroundColor3 = C_ACCENT2
            RGlow.BackgroundTransparency = 1
            RGlow.BorderSizePixel  = 0
            RGlow.ZIndex           = 11
            Instance.new("UICorner", RGlow).CornerRadius = UDim.new(0, 7)
            local RGlowGrad = Instance.new("UIGradient", RGlow)
            RGlowGrad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0.75),
