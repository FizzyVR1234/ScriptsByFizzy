    BodyPan.BorderSizePixel  = 0
    BodyPan.ClipsDescendants = true
    BodyPan.Visible          = false
    BodyPan.ZIndex           = 9

    local Body = Instance.new("ScrollingFrame", BodyPan)
    Body.Size                = UDim2.new(1, 0, 1, 0)
    Body.BackgroundTransparency = 1
    Body.BorderSizePixel     = 0
    Body.ScrollBarThickness  = 0
    Body.CanvasSize          = UDim2.new(0, 0, 0, 0)
