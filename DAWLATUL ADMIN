            CmdLbl.Position         = UDim2.new(0, 10, 0, 0)
            CmdLbl.BackgroundTransparency = 1
            CmdLbl.Font             = Enum.Font.Code
            CmdLbl.TextSize         = FR
            CmdLbl.TextColor3       = C_ACCENT
            CmdLbl.TextXAlignment   = Enum.TextXAlignment.Left
            CmdLbl.Text             = cmdData.cmd
            CmdLbl.ZIndex           = 12

            local DescLbl = Instance.new("TextLabel", Row)
            DescLbl.Size            = UDim2.new(1, -(IsMobile and 138 or 118), 1, 0)
            DescLbl.Position        = UDim2.new(0, IsMobile and 134 or 114, 0, 0)
            DescLbl.BackgroundTransparency = 1
            DescLbl.Font            = Enum.Font.Code
            DescLbl.TextSize        = FS
            DescLbl.TextColor3      = C_DIM
            DescLbl.TextXAlignment  = Enum.TextXAlignment.Left
            DescLbl.Text            = cmdData.desc
            DescLbl.TextTruncate    = Enum.TextTruncate.AtEnd
            DescLbl.ZIndex          = 12

            -- Hover / click interactions
            if cmdData.func then
                if not IsMobile then
                    addC(Row.MouseEnter:Connect(function()
                        TweenService:Create(Row,  TW_HOVER_IN, { BackgroundColor3 = C_ROW_H, BackgroundTransparency = 0 }):Play()
                        TweenService:Create(ABar, TW_HOVER_IN, { BackgroundTransparency = 0.15 }):Play()
                        TweenService:Create(RGlow,TW_HOVER_IN, { BackgroundTransparency = 0.88 }):Play()
                        TweenService:Create(CmdLbl,TW_HOVER_IN,{ TextColor3 = Color3.fromRGB(200, 190, 255) }):Play()
                    end))
                    addC(Row.MouseLeave:Connect(function()
                        TweenService:Create(Row,  TW_HOVER_OUT, { BackgroundColor3 = C_ROW, BackgroundTransparency = 0.08 }):Play()
                        TweenService:Create(ABar, TW_HOVER_OUT, { BackgroundTransparency = 1 }):Play()
                        TweenService:Create(RGlow,TW_HOVER_OUT, { BackgroundTransparency = 1 }):Play()
                        TweenService:Create(CmdLbl,TW_HOVER_OUT,{ TextColor3 = C_ACCENT }):Play()
                    end))
                end
                addC(Row.Activated:Connect(function()
                    if IsCmdOnCooldown(cmdData.cmd) then return end
                    TweenService:Create(Row,  TW_CLICK,     { BackgroundColor3 = C_ACCENT, BackgroundTransparency = 0.55 }):Play()
                    TweenService:Create(ABar, TW_CLICK,     { BackgroundTransparency = 0 }):Play()
                    task.delay(0.10, function()
                        if not Row or not Row.Parent then return end
                        TweenService:Create(Row,  TW_CLICK_OUT, { BackgroundColor3 = C_ROW, BackgroundTransparency = 0.08 }):Play()
                        TweenService:Create(ABar, TW_CLICK_OUT, { BackgroundTransparency = 1 }):Play()
