-- ── apply_theme: swaps colors/text on an existing toast ──────────────────────
local function apply_theme(toast, th, newPill, newTitle, newSub, newIcon)
    toast.header.BackgroundColor3    = th.headerBg
    toast.headerFix.BackgroundColor3 = th.headerBg
    toast.dot.BackgroundColor3       = th.dotColor
    toast.dotRing.BackgroundColor3   = th.dotColor
    toast.pill.TextColor3            = th.pillColor
    toast.pill.Text                  = newPill
    toast.cardStroke.Color           = th.stroke
    toast.subLbl.TextColor3          = th.titleColor
    toast.subLbl.Text                = newSub
    toast.titleLbl.TextColor3        = th.subColor
    toast.titleLbl.Text              = newTitle
    toast.progFill.BackgroundColor3  = th.barColor
    toast.iconBox.BackgroundColor3   = th.iconBg
    toast.iconLbl.TextColor3         = th.iconColor
    toast.iconLbl.Text               = newIcon
    toast.divider.BackgroundColor3   = th.divColor
end

-- ── animate_toast: drives slide-in / progress / slide-out lifecycle ──────────
local function animate_toast(toast, mode, holdTime, procRef)
    local CARD_OFF     = -120
    local CARD_ON      = 14
    local SLIDE_IN     = 0.36
    local SLIDE_OUT    = 0.26
    local SHIM_CYCLE   = 3.2
    local TOTAL_PROC   = 6.7

    local phase   = "slide_in"
    local timer   = 0
    local globalT = 0

    local function set_y(y)
        toast.card.Position = UDim2.new(0.5, 0, 0, math.round(y))
    end

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        timer   = timer   + dt
        globalT = globalT + dt

        -- Dot ring pulse
        local pt      = globalT % 1.6
        local ringT   = math.clamp(pt / 1.6, 0, 1)
        local easedT  = ringT < 0.5
            and 2 * ringT * ringT
            or  1 - (-2 * ringT + 2)^2 / 2
        local ringSize  = math.round(6 + (14.4 - 6) * easedT)
        local ringAlpha = 0.5 + 0.5 * easedT
        if toast.dotRing and toast.dotRing.Parent then
            toast.dotRing.Size                 = UDim2.new(0, ringSize, 0, ringSize)
            toast.dotRing.BackgroundTransparency = ringAlpha
        end

        -- Shimmer sweep
        local st = globalT % SHIM_CYCLE
        local sf = st / (SHIM_CYCLE * 0.55)
        if sf <= 1 then
            toast.shimmer.Position = UDim2.new(-0.5 + 1.5 * ease_out(sf), 0, 0, 0)
        else
            toast.shimmer.Position = UDim2.new(1.1, 0, 0, 0)
        end

        -- Phase state machine
        if phase == "slide_in" then
            local t = math.clamp(timer / SLIDE_IN, 0, 1)
            set_y(CARD_OFF + (CARD_ON - CARD_OFF) * ease_out(t))
            if t >= 1 then
                set_y(CARD_ON)
                phase = (mode == "processing") and "processing" or "hold"
                timer = 0
            end

        elseif phase == "hold" then
            local t = math.clamp(1 - timer / holdTime, 0, 1)
            toast.progFill.Size = UDim2.new(t, 0, 1, 0)
            if timer >= holdTime then
                phase = "slide_out"
                timer = 0
            end

        elseif phase == "processing" then
            local prog = math.clamp(timer / TOTAL_PROC, 0, 0.97)
            toast.progFill.Size = UDim2.new(prog, 0, 1, 0)
            if procRef and procRef.done then
                phase = "fill_complete"
                timer = 0
            end

        elseif phase == "fill_complete" then
            local t = math.clamp(timer / 0.25, 0, 1)
            toast.progFill.Size = UDim2.new(ease_out(t), 0, 1, 0)
            if t >= 1 then
                toast.progFill.Size = UDim2.new(1, 0, 1, 0)
                if procRef and procRef.onTransition then
                    procRef.onTransition()
                end
                phase = "hold"
                timer = 0
            end

        elseif phase == "slide_out" then
            local t = math.clamp(timer / SLIDE_OUT, 0, 1)
            set_y(CARD_ON + (CARD_OFF - CARD_ON) * ease_in(t))
            if t >= 1 then
                conn:Disconnect()
                if toast.gui and toast.gui.Parent then
                    toast.gui:Destroy()
                end
            end
        end
    end)

    return conn
end

