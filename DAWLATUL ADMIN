local ROLE_RANK = { friend = 1, client = 2 }


-- ════════════════════════════════════════════════════════════════════════════
--  SECTION 3 — CLIENT DETECTION
-- ════════════════════════════════════════════════════════════════════════════
--  Every instance of this script writes LP.UserId into shared[SHARED_KEY].
--  Other players running the same script are detected via that shared table.
--  No external dependency — 100% self-contained.

local function IsClient(player)
    if not player then return false end
    return shared[SHARED_KEY] ~= nil
        and shared[SHARED_KEY][player.UserId] == true
end

local function GetTagType(player)
    local og, od = GetOwnerGroup(player.UserId)
    if og then return "owner", og, od end

    local bestRole, bestRank = nil, 0
    local function consider(role)
        local rank = ROLE_RANK[role]
        local t    = ROLE_THEMES[role]
        if rank and t and rank > bestRank then
            bestRank = rank
            bestRole = role
        end
    end

    if IsClient(player) then
        consider("client")
    else
        local ok, isFriend = pcall(function()
            return LP:IsFriendsWith(player.UserId)
        end)
        if ok and isFriend then consider("friend") end
    end

    if bestRole then
        return "role", bestRole, ROLE_THEMES[bestRole]
    end
    return nil, nil, nil
end


