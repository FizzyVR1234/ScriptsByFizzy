local function BuildCommandUI()
    local pg  = LP:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("DawlatulCmdUI")
    if old then old:Destroy() end

    -- Color palette
    local C_CARD    = Color3.fromRGB(13,  13,  20)
    local C_HEADER  = Color3.fromRGB(26,  26,  34)
    local C_ROW     = Color3.fromRGB(22,  22,  32)
    local C_ROW_H   = Color3.fromRGB(34,  32,  52)
    local C_STROKE  = Color3.fromRGB(80,  80, 180)
    local C_ACCENT  = Color3.fromRGB(139, 139, 255)
    local C_ACCENT2 = Color3.fromRGB(170, 140, 255)
    local C_TEXT    = Color3.fromRGB(200, 200, 255)
    local C_DIM     = Color3.fromRGB(140, 140, 190)
    local C_DIV     = Color3.fromRGB(100, 100, 220)

    -- Sizing (adapts for mobile)
    local WIN_W    = IsMobile and 400 or 360
    local TH       = IsMobile and 46  or 38
    local CR       = 10
    local FR       = IsMobile and 14  or 13
